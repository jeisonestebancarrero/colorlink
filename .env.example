# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# SUPABASE — CLIENTE (navegador)
# ============================================================
# Estas dos variables SÍ se incluyen en el bundle del frontend. Es seguro:
# la anon key está diseñada para ser pública y toda la autorización la aplica
# Row Level Security en Postgres.
#
# Obtén los valores locales ejecutando: npm run db:status
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# ============================================================
# SUPABASE — SERVIDOR (migraciones, seeds, Edge Functions)
# ============================================================
# ⚠️  NUNCA prefijar con VITE_. NUNCA importar desde src/.
# ⚠️  NUNCA commitear con valores reales.
# La service_role key ignora por completo RLS: es equivalente a superusuario.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ============================================================
# ACCESO CON GOOGLE (opcional)
# ============================================================
# Poner en "true" y rellenar las credenciales para habilitar el botón
# "Continuar con Google". Obtenerlas en Google Cloud Console →
# APIs y servicios → Credenciales → ID de cliente de OAuth 2.0 (Aplicación web).
#
# URI de redirección autorizada que hay que registrar en Google:
#   Local:      http://127.0.0.1:54321/auth/v1/callback
#   Producción: https://<tu-proyecto>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_ENABLED="false"
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="MY_GOOGLE_CLIENT_SECRET"
