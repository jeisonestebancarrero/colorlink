# Clave de Gemini; en AI Studio se inyecta desde los secretos del usuario.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública de la app (enlaces propios y callbacks de OAuth); AI Studio la inyecta.
APP_URL="MY_APP_URL"

# Cliente: van en el bundle; la anon key es pública y la autorización la aplica RLS.
# Valores locales: npm run db:status
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Servidor (migraciones, seeds, funciones). La service_role ignora RLS:
# NUNCA con prefijo VITE_, nunca desde src/ y nunca con valores reales en git.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Google opcional (cliente OAuth 2.0 web). Redirección a registrar:
# local http://127.0.0.1:54321/auth/v1/callback · nube https://<proyecto>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_ENABLED="false"
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="MY_GOOGLE_CLIENT_SECRET"
